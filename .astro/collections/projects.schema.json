{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "titleEs": {
      "type": "string"
    },
    "descriptionEs": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "labelEs": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label",
          "labelEs"
        ]
      }
    },
    "tech": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "titleEs",
    "descriptionEs",
    "category",
    "outcomes",
    "tech",
    "image"
  ]
}