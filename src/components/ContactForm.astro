<form id="contact-form" class="minimal-form" data-formspree-id="mgodjnpp">
  <div class="form-group">
    <input type="text" name="name" id="name" autocomplete="name" placeholder="Name" aria-label="Name" aria-describedby="name-error" data-t="name_placeholder" required />
    <span id="name-error" class="form-error" hidden></span>
  </div>
  <div class="form-group">
    <input type="email" name="email" id="email" autocomplete="email" placeholder="Email" aria-label="Email" aria-describedby="email-error" data-t="email_placeholder" required />
    <span id="email-error" class="form-error" hidden></span>
  </div>
  <div class="form-group">
    <textarea name="message" id="message" placeholder="Message…" aria-label="Message" aria-describedby="message-error" data-t="message_placeholder" rows="3" required></textarea>
    <span id="message-error" class="form-error" hidden></span>
  </div>
  <button type="submit" class="submit-btn"><span data-t="send">Send</span><i data-lucide="arrow-right"></i></button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
