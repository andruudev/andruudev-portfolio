---
import Copy from './Copy.astro';
const year = new Date().getUTCFullYear();
---
<footer class="footer animate">
  <div class="footer-content">
    <p class="copyright">© {year} Jeyson Andrés Mueses</p>
    <Copy as="p" class="footer-origin" text={{ en: 'Built with care in Ecuador 🇪🇨. Shared with the world.', es: 'Hecho con cariño en Ecuador 🇪🇨. Compartido con el mundo.' }} />
  </div>
  <p class="footer-signature">By people fifirisnais,<br class="footer-break" /> para la people fifirisnais.</p>
</footer>
