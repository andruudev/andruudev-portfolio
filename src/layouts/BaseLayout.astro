---
import "../styles/global.css";
import { pageMetadata } from "../i18n/page-metadata";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
	title?: string;
	titleEs?: string;
	description?: string;
	descriptionEs?: string;
	image?: string;
	imageAlt?: string;
	ogType?: "website" | "article" | "profile";
	canonicalURL?: string;
	lang?: string;
	hideHeader?: boolean;
	hideFooter?: boolean;
	hideMenu?: boolean;
}

const siteUrl = Astro.site ? Astro.site.href : "https://www.andruudev.com/";

const {
	title = "Jeyson Andrés Mueses | Portfolio | Cloud & DevOps Engineer",
	description = "Cloud & DevOps Engineer focused on AWS infrastructure, Kubernetes orchestration, CI/CD automation, and scalable cloud architectures.",
	image = "/assets/og-image.png",
	imageAlt = "Jeyson Andrés Mueses (andruudev) - Cloud & DevOps Engineer Portfolio",
	ogType = "website",
	canonicalURL = new URL(Astro.url.pathname, siteUrl).href,
	lang = "en",
	hideHeader = false,
	hideFooter = false,
	hideMenu = false,
} = Astro.props;

// Social platforms generally expect raster previews; SVG architecture diagrams stay in-page.
const socialImage = image.endsWith('.svg') ? '/assets/og-image.png' : image;
const pagePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const spanishTitle = Astro.props.titleEs ?? pageMetadata[pagePath]?.title ?? title;
const spanishDescription = Astro.props.descriptionEs ?? pageMetadata[pagePath]?.description ?? description;
const ogImageUrl = new URL(socialImage, siteUrl).href;
const ogImageType = /\.jpe?g$/i.test(socialImage) ? 'image/jpeg' : 'image/png';
const locale = lang === "es" ? "es_EC" : "en_US";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/assets/logo-andruudev.png" />
		<link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Meta Etiquetas Principales -->
		<title data-en={title} data-es={spanishTitle}>{title}</title>
		<meta name="title" data-content-en={title} data-content-es={spanishTitle} content={title} />
		<meta name="description" data-content-en={description} data-content-es={spanishDescription} content={description} />
		<meta name="author" content="Jeyson Andrés Mueses (andruudev)" />

		<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="andruudev | Jeyson Andrés Mueses" />
		<meta property="og:title" data-content-en={title} data-content-es={spanishTitle} content={title} />
		<meta property="og:description" data-content-en={description} data-content-es={spanishDescription} content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={locale} />

		<!-- Twitter Cards / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@andruudev" />
		<meta name="twitter:creator" content="@andruudev" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" data-content-en={title} data-content-es={spanishTitle} content={title} />
		<meta name="twitter:description" data-content-en={description} data-content-es={spanishDescription} content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<!-- Fix FOUC: apply saved theme BEFORE first paint -->
		<script is:inline>
			(function () {
				var saved = "light";
				try { saved = localStorage.getItem("theme") === "dark" ? "dark" : "light"; } catch {}
				document.documentElement.setAttribute("data-theme", saved);
			})();
		</script>

		<script
			is:inline
			src="/vendor/gsap-3.12.5.min.js"
		></script>
		<script
			is:inline
			src="/vendor/ScrollTrigger-3.12.5.min.js"
		></script>
		<script is:inline src="/vendor/lenis-1.1.2.min.js"
		></script>
		<script is:inline src="/vendor/lucide-1.72.0.min.js"></script>

		<noscript><style>#system-preloader, #transition-overlay, #cursor { display: none !important; }</style></noscript>
		<ClientRouter />
	</head>
	<body>
		<p class="sr-only" id="language-status" role="status" aria-live="polite" aria-atomic="true"></p>
		<div id="system-preloader">
			<div class="preloader-content">
				<div class="preloader-text" data-t="system_initializing">
					LOADING_PORTFOLIO…
				</div>
				<div class="preloader-bar-bg">
					<div class="preloader-bar"></div>
				</div>
				<div class="preloader-status" data-t="encrypting_session">
					CLOUD & DEVOPS / ECUADOR
				</div>
			</div>
		</div>

		<div id="transition-overlay">
			<div class="transition-column"></div>
			<div class="transition-column"></div>
			<div class="transition-column"></div>
			<div class="transition-column"></div>
			<div class="transition-column"></div>
		</div>

		<div id="progress-bar"></div>
		<div id="cursor"></div>
		<canvas id="noiseCanvas"></canvas>

		<ThemeToggle />
		<LangToggle />
		{!hideMenu && <CommandPalette />}

		<!-- Mobile Unified Nav Bar -->
		<div id="mobile-nav-bar">
			<!-- Theme -->
			<button
				class="mobile-nav-btn"
				id="mobileThemeBtn"
				aria-label="Toggle theme"
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
					></path>
				</svg>
				<span class="mobile-nav-label" id="mobileThemeLabel">Light</span
				>
			</button>

			<div class="mobile-nav-divider"></div>

			<!-- Language -->
			<button
				class="mobile-nav-btn"
				id="mobileLangBtn"
				aria-label="Switch to Spanish" title="Current language: English. Switch to Spanish."
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="10"></circle>
					<path
						d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
					></path>
					<path d="M2 12h20"></path>
				</svg>
				<span class="mobile-nav-label" id="mobileLangLabel" lang="es">Español</span>
			</button>

			{!hideMenu && <div class="mobile-nav-divider"></div>}

			<!-- Menu -->
			{!hideMenu && (
				<button
					class="mobile-nav-btn"
					id="mobileMenuBtn"
					aria-label="Open navigation menu" data-i18n-aria="open_menu"
					aria-expanded="false"
					aria-controls="modalOverlay"
				>
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						id="mobileMenuIcon"
					>
						<line x1="4" y1="6" x2="20" y2="6"></line>
						<line x1="4" y1="12" x2="20" y2="12"></line>
						<line x1="4" y1="18" x2="20" y2="18"></line>
					</svg>
					<span class="mobile-nav-label" data-t="menu">Menu</span>
				</button>
			)}
		</div>

		<div class="container">
			{!hideHeader && <Header />}
			<main id="app">
				<slot />
			</main>
			{!hideFooter && <Footer />}
		</div>

		<script>
			import "../scripts/portfolio.js";
		</script>
	</body>
</html>
