---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Jeyson Andrés Mueses">
  <section class="animate">
    <span class="section-label" data-t="about_intro_label">[01] Profile</span>
    <div class="content-text">
      <p data-t="about_text_1">
        I'm Jeyson Andrés Mueses, a Cloud & DevOps Engineer based in
        Ecuador. Leader at awspuce.com and creative director at velitty.com.
      </p>
      <p data-t="about_text_2">
        I believe modern software delivery requires resilient infrastructure,
        repeatable deployments, and high-velocity automation. My work sits at
        the intersection of cloud architecture, Infrastructure as Code, and
        developer platforms: designing highly available multi-region topologies,
        orchestrating containers with Kubernetes, and automating zero-downtime
        CI/CD deployment pipelines.
      </p>
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="about_what_label">[02] What I do</span>
    <div class="content-text">
      <p data-t="about_text_3">
        I work across the full cloud and DevOps lifecycle — from provisioning
        AWS infrastructure with Terraform to architecting Kubernetes clusters,
        implementing GitOps workflows with ArgoCD, and instrumenting full-stack
        observability with Prometheus and Grafana. I thrive in environments where
        infrastructure reliability, security, and developer productivity are top
        priorities.
      </p>
    </div>
  </section>

  <section class="animate">
    <span class="section-label">[03] Currently using</span>
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title"><i data-lucide="cloud"></i> Cloud Platform</span
        >
        <span class="item-meta">AWS / Azure / Cloudflare</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title"><i data-lucide="container"></i> Containers & Orchestration</span>
        <span class="item-meta">Docker / Kubernetes / Helm</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title"><i data-lucide="cpu"></i> IaC & GitOps</span>
        <span class="item-meta">Terraform / ArgoCD / GitHub Actions</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title"><i data-lucide="terminal"></i> Language & OS</span>
        <span class="item-meta">Python / Bash / Linux</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title"><i data-lucide="activity"></i> Observability & DB</span>
        <span class="item-meta">Prometheus / Grafana / PostgreSQL</span>
      </div>
    </div>
  </section>

  <div style="margin-top: 40px;">
    <a
      href="/portfolio"
      class="nav-link"
      style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 13px; text-decoration: none;"
      data-t="back_home"><i data-lucide="arrow-left"></i> Back to Home</a
    >
  </div>
</BaseLayout>
