---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Copy from '../../../components/Copy.astro';
import LocalizedDate from '../../../components/LocalizedDate.astro';
import { copy } from '../../../data/profile';
import { categoryCopy } from '../../../i18n/language.js';
import { getBlogPosts } from '../../../data/content';
export async function getStaticPaths() {
  return getBlogPosts().map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const english = entry.translation;
const EnglishContent = english.Content;
const SpanishContent = entry.Content;
const minutes = Math.max(1, Math.ceil((english.body ?? '').split(/\s+/).length / 200));
const minutesEs = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 200));
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: english.data.title,
  description: english.data.description, datePublished: entry.data.date,
  dateModified: entry.data.updated ?? entry.data.date,
  inLanguage: ['en', 'es'], author: { '@type': 'Person', name: 'Jeyson Andrés Mueses', url: Astro.site?.href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout title={`${english.data.title} | Field Notes`} titleEs={`${entry.data.title} | Notas de campo`} description={english.data.description ?? ''} descriptionEs={entry.data.description} ogType="article">
  <article class="animate">
    <div class="article-meta"><Copy class="eyebrow" text={categoryCopy(entry.data.tag)} /><Copy class="eyebrow" text={copy(`${minutes} min read`, `${minutesEs} min de lectura`)} /></div>
    <Copy as="h1" class="page-title" text={copy(english.data.title,entry.data.title)} />
    <Copy as="p" class="section-intro" text={copy(english.data.description ?? '',entry.data.description ?? '')} />
    <p class="article-byline"><span>Jeyson Andrés Mueses</span><LocalizedDate value={entry.data.date} />{entry.data.updated && <span><Copy text={copy('Updated', 'Actualizado')} /> <LocalizedDate value={entry.data.updated} /></span>}</p>
    {!entry.hasTranslation && <Copy as="p" class="study-note" text={copy('This article is currently available in Spanish.', 'Este artículo está disponible en español.')} />}
    <div class="prose" data-language-content="en" lang={english.language}><EnglishContent /></div>
    <div class="prose" data-language-content="es" lang="es" hidden><SpanishContent /></div>
  </article>
  <div class="case-footer"><a href="/portfolio/blog" class="text-link"><i data-lucide="arrow-left"></i><Copy text={copy('All field notes', 'Todas las notas')} /></a><a href="/portfolio#contact" class="text-link"><Copy text={copy('Let’s discuss it', 'Conversemos sobre esto')} /> ↗</a></div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />
</BaseLayout>
