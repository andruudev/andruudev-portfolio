---
import BlogList from "../../../components/BlogList.astro";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Copy from '../../../components/Copy.astro';
import { copy } from '../../../data/profile';
import { getBlogPosts } from '../../../data/content';
const posts = getBlogPosts().sort((a,b) => (b.data.updated ?? b.data.date).localeCompare(a.data.updated ?? a.data.date) || a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Field Notes | Cloud & DevOps | Jeyson Andrés Mueses" description="Practical notes on AWS, Terraform, Kubernetes, GitOps and observability.">
  <section class="animate">
    <span class="section-label" data-t="blog_label">[10] Field notes</span>
    <Copy as="h1" class="page-title" text={copy('Notes from the cloud side.', 'Notas desde el lado cloud.')} />
    <Copy as="p" class="section-intro" text={copy('Ideas, practical guides and design decisions. Read every article in English or Spanish using the language button.', 'Ideas, guías prácticas y decisiones de diseño. Lee cada artículo en inglés o español con el botón de idioma.')} />
    <BlogList posts={posts} />
  </section>
  <a href="/portfolio" class="text-link" data-t="back_home">Back to home</a>
</BaseLayout>
