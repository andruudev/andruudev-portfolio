---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventsGrid from "../../components/EventsGrid.astro";
import Copy from "../../components/Copy.astro";
---
<BaseLayout title="Events & Community | Jeyson Andrés Mueses" description="Staff at GDG DevFest 2026 and AWS Community Day Ecuador 2026. AWS speaker at NASA Space Apps Challenge.">
  <section class="animate">
    <span class="section-label" data-t="events_label">[08] Events & Staff</span>
    <Copy as="h1" class="page-title" text={{ en: 'Building with the community.', es: 'Construyendo en comunidad.' }} />
    <Copy as="p" class="section-intro" text={{ en: 'Sometimes behind the scenes. Sometimes on stage. Always sharing what we learn.', es: 'A veces detrás del escenario. A veces dando una charla. Siempre compartiendo lo que aprendemos.' }} />
    <EventsGrid />
  </section>
  <a href="/portfolio" class="text-link" data-t="back_home"><i data-lucide="arrow-left"></i> Back to Home</a>
</BaseLayout>
