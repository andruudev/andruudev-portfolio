---
import { copy } from "../../data/profile";
import Copy from "../../components/Copy.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Experience | Jeyson Andrés Mueses">
  <section class="animate">
    <span class="section-label" data-t="experience_label">[08] Experience</span>
    <h1 style="font-family: var(--font-sans); font-size: 24px; margin-bottom: 24px;" data-t="experience_title">Work Experience</h1>

    <div class="items-list">
      <div class="item" style="flex-direction: column; align-items: flex-start; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--border-color);">
        <div class="item-header">
          <span style="font-weight: 500;"><Copy text={copy('Cloud & DevOps Engineer', 'Ingeniero Cloud y DevOps')} /></span>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);"><Copy text={copy('2023 — Present', '2023 — Actualidad')} /></span>
        </div>
        <span style="font-size: 13px; color: var(--text-secondary);">Corporación Favorita · Quito, Ecuador</span>
        <Copy as="p" class="muted" text={{"en": "Architecting and automating cloud infrastructure on AWS and Azure using Terraform and Docker. Implemented automated CI/CD deployment pipelines with GitHub Actions, accelerating release cycles from days to under 15 minutes. Managed Kubernetes clusters (EKS), container orchestration, and established centralized observability using Prometheus and Grafana for critical production workloads.", "es": "Diseño y automatización de infraestructura cloud en AWS y Azure con Terraform y Docker. Implementación de pipelines CI/CD con GitHub Actions que redujeron los ciclos de entrega de días a menos de 15 minutos. Gestión de clústeres Kubernetes (EKS), orquestación de contenedores y observabilidad centralizada con Prometheus y Grafana para cargas de producción críticas."}} />
      </div>

      <div class="item" style="flex-direction: column; align-items: flex-start; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--border-color);">
        <div class="item-header">
          <span style="font-weight: 500;"><Copy text={copy('Junior Cloud & Infrastructure Engineer', 'Ingeniero junior de infraestructura cloud')} /></span>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">2022 — 2023</span>
        </div>
        <span style="font-size: 13px; color: var(--text-secondary);">Banco Pichincha · Quito, Ecuador</span>
        <Copy as="p" class="muted" text={{"en": "Supported the infrastructure and platform engineering team in migrating on-premise systems to hybrid cloud environments. Automated system administration tasks, Linux server hardening, and containerization with Docker. Maintained database reliability, backup automation, and monitoring across microservices.", "es": "Apoyo al equipo de infraestructura en migraciones desde sistemas locales a entornos híbridos. Automatización de administración, hardening de Linux y contenedores con Docker; mantenimiento de backups y monitoreo de microservicios."}} />
      </div>

      <div class="item" style="flex-direction: column; align-items: flex-start; gap: 4px; padding: 16px 0;">
        <div class="item-header">
          <span style="font-weight: 500;"><Copy text={copy('DevOps & Systems Administrator Intern', 'Practicante de DevOps y administración de sistemas')} /></span>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary);">2021 — 2022</span>
        </div>
        <span style="font-size: 13px; color: var(--text-secondary);"><Copy text={copy('Freelance · Remote', 'Independiente · Remoto')} /></span>
        <Copy as="p" class="muted" text={{"en": "Delivered infrastructure provisioning, Linux server configuration, and web deployment pipelines for 4 SMEs. Configured Nginx reverse proxies, SSL/TLS automation, and automated backup workflows using Bash scripts and Docker Compose.", "es": "Aprovisionamiento de infraestructura, configuración de servidores Linux y flujos de despliegue para cuatro pequeñas y medianas empresas. Configuración de Nginx, automatización SSL/TLS y backups con Bash y Docker Compose."}} />
      </div>
    </div>
  </section>

  <div style="margin-top: 40px;">
    <a href="/portfolio" class="nav-link" style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 13px; text-decoration: none;" data-t="back_home"><i data-lucide="arrow-left"></i> Back to Home</a>
  </div>
</BaseLayout>
