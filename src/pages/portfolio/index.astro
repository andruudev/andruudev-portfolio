---
import BlogList from "../../components/BlogList.astro";
import { categoryCopy } from "../../i18n/language.js";
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Copy from '../../components/Copy.astro';
import ProfileEntries from '../../components/ProfileEntries.astro';
import EventsGrid from '../../components/EventsGrid.astro';
import { education, leadership, stack, copy } from '../../data/profile';
import { getBlogPosts, getProjects } from '../../data/content';
const projects = getProjects().sort((a,b) => Number(b.data.featured)-Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
const featured = projects[0];
const blogPosts = getBlogPosts().sort((a,b) => (b.data.updated ?? b.data.date).localeCompare(a.data.updated ?? a.data.date)).slice(0,4);
---
<BaseLayout>
  <section class="animate intro-section">
    <span class="section-label" data-t="profile_label">[01] About me</span>
    <Copy as="h1" class="sr-only" text={copy('Cloud & DevOps Engineer', 'Ingeniero Cloud y DevOps')} />
    <p class="content-text" data-t="profile_text">I’m a Cloud & DevOps Engineer focused on AWS, Infrastructure as Code and reliable software delivery. I lead the community at awspuce.com and bring a creative perspective through velitty.com.</p>
    <div class="intro-tags"><span>AWS</span><Copy text={copy("Infrastructure as Code", "Infraestructura como Código")} /><span>GitOps</span></div>
    <a href="/portfolio/about" class="text-link"><Copy text={copy('More about me', 'Más sobre mí')} /> <span aria-hidden="true">↗</span></a>
  </section>

  <section class="animate" id="projects">
    <span class="section-label" data-t="work_label">[02] Projects</span>
    <Copy as="p" class="section-intro" text={copy('Cloud & DevOps design studies. Fictional scenarios, explicit trade-offs and a plan to test each assumption.', 'Casos de diseño Cloud & DevOps. Escenarios ficticios, decisiones explícitas y un plan para probar cada supuesto.')} />
    <a href={`/portfolio/project/${featured.id}`} class="featured-project">
      <div class="project-art"><img src={featured.data.image} data-src-en={featured.data.image} data-src-es={featured.data.image.replace(".svg", ".es.svg")} data-alt-en={`Architecture: ${featured.data.title}`} data-alt-es={`Arquitectura: ${featured.data.titleEs}`} alt={`Architecture: ${featured.data.title}`} width="1200" height="630" loading="lazy" decoding="async" /></div>
      <div class="featured-body">
        <div class="entry-heading"><Copy class="eyebrow" text={copy('Featured / Design study', 'Destacado / Caso de diseño')} /><i data-lucide="arrow-up-right"></i></div>
        <Copy as="h3" text={copy(featured.data.title,featured.data.titleEs)} />
        <Copy as="p" class="muted" text={copy(featured.data.description ?? '',featured.data.descriptionEs)} />
        <span class="project-stack">{featured.data.tech}</span>
      </div>
    </a>
    <div class="project-grid">{projects.slice(1).map(project => <a class="project-card" href={`/portfolio/project/${project.id}`}>
      <div class="entry-heading"><Copy class="eyebrow" text={categoryCopy(project.data.category)} /><i data-lucide="arrow-up-right"></i></div>
      <Copy as="h3" text={copy(project.data.title,project.data.titleEs)} />
      <Copy as="p" class="muted" text={copy(project.data.description ?? '',project.data.descriptionEs)} />
      <span class="project-stack">{project.data.tech}</span>
    </a>)}</div>
  </section>

  <section class="animate">
    <Copy class="section-label" text={copy('[03] Cloud & DevOps Stack', '[03] Stack Cloud & DevOps')} />
    <div class="capability-grid">{stack.map(group => <div class="capability-card"><i data-lucide={group.icon}></i><Copy as="h3" text={group.title} /><ul>{group.tools.map(tool => <li>{tool}</li>)}</ul></div>)}</div>
    <a href="/portfolio/skills" class="text-link"><Copy text={copy('Explore the lab stack', 'Explorar el stack de los laboratorios')} /> ↗</a>
  </section>

  <section class="animate">
    <span class="section-label" data-t="experience_label">[04] Experience</span>
    <div class="profile-entries">
      <div class="profile-entry"><Copy as="h3" text={copy("Cloud & DevOps Engineer", "Ingeniero Cloud y DevOps")} /><p class="entry-organization">Corporación Favorita</p></div>
      <div class="profile-entry"><Copy as="h3" text={copy("Junior Cloud & Infrastructure Engineer", "Ingeniero junior de infraestructura cloud")} /><p class="entry-organization">Banco Pichincha</p></div>
    </div>
    <a href="/portfolio/experience" class="text-link"><Copy text={copy('Experience & responsibilities', 'Experiencia y responsabilidades')} /> ↗</a>
  </section>

  <section class="animate">
    <span class="section-label" data-t="education_label">[05] Education</span>
    <ProfileEntries entries={education} compact />
    <a href="/portfolio/education" class="text-link" data-t="see_more">See more</a>
  </section>

  <section class="animate">
    <span class="section-label" data-t="certifications_label">[06] Certifications</span>
    <a class="item" href="/portfolio/certifications"><Copy text={copy('Certifications & technical learning', 'Certificaciones y formación técnica')} /><i data-lucide="arrow-up-right"></i></a>
  </section>

  <section class="animate">
    <span class="section-label" data-t="leadership_label">[07] Leadership</span>
    <ProfileEntries entries={leadership} compact />
    <a href="/portfolio/leadership" class="text-link" data-t="see_more">See more</a>
  </section>

  <section class="animate">
    <span class="section-label" data-t="events_label">[08] Events & Staff</span>
    <EventsGrid linked />
  </section>

  <section class="animate">
    <span class="section-label" data-t="blog_label">[09] Field notes</span>
    <Copy as="p" class="section-intro" text={copy('Practical notes on infrastructure, delivery and keeping systems understandable.', 'Notas prácticas sobre infraestructura, entrega y sistemas que se pueden entender.')} />
    <BlogList posts={blogPosts} />
    <a href="/portfolio/blog" class="text-link"><Copy text={copy('All field notes', 'Todas las notas')} /> ↗</a>
  </section>

  <section class="animate" id="contact">
    <span class="section-label" data-t="connect_label">[10] Connect</span>
    <Copy as="p" class="section-intro" text={copy('Have an infrastructure challenge, a collaboration or a community idea? Let’s talk.', '¿Tienes un reto de infraestructura, una colaboración o una idea para la comunidad? Conversemos.')} />
    <ContactForm />
  </section>

  <section class="animate" id="network-visualizer">
    <Copy class="section-label" text={copy('[11] Inside the lab', '[11] Dentro del laboratorio')} />
    <div class="lab-console"><div class="entry-heading"><span class="console-dot" aria-hidden="true"></span><Copy class="eyebrow" text={copy('Simulation / no live infrastructure', 'Simulación / sin infraestructura en vivo')} /></div>
      <Copy as="p" class="muted" text={copy('A small operational demo. These sample events do not represent a production cluster or measured service health.', 'Una pequeña demo operativa. Estos eventos de ejemplo no representan un clúster de producción ni métricas reales.')} />
      <div class="node-metrics" id="live-metrics"><span data-t="sample_events">DEMO / SAMPLE EVENTS</span><span id="demo-elapsed"></span></div><div class="system-logs" id="system-logs" aria-hidden="true"></div>
      <a href="/portfolio/project/observability-control-plane" class="text-link"><Copy text={copy('Explore the observability design', 'Explorar el diseño de observabilidad')} /> ↗</a>
    </div>
  </section>
</BaseLayout>
