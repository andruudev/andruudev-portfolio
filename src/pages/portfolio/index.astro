---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const blogPosts = allPosts
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3);
---

<BaseLayout>
  <section class="animate">
    <span class="section-label" data-t="profile_label">[01] Profile</span>
    <div class="content-text">
      <p data-t="profile_text">
        I'm a Cloud & DevOps Engineer focused on designing scalable cloud
        architectures, Kubernetes orchestration, CI/CD automation, and
        Infrastructure as Code. Leader at awspuce.com and creative director at
        velitty.com.
      </p>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/about"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="work_label">[02] Work</span>
    <div class="items-list">
      <a href="/portfolio/project/sales-intelligence" class="item nav-link">
        <span class="item-title"
          ><i data-lucide="cloud"></i> Multi-Cloud Infrastructure with Terraform</span
        >
        <span class="item-meta">Terraform + AWS + GitHub Actions</span>
      </a>
      <a href="/portfolio/project/retail-analytics" class="item nav-link">
        <span class="item-title"
          ><i data-lucide="container"></i> Kubernetes GitOps CI/CD Platform</span
        >
        <span class="item-meta">Kubernetes + ArgoCD + Docker</span>
      </a>
      <a href="/portfolio/project/supply-chain" class="item nav-link">
        <span class="item-title"
          ><i data-lucide="cpu"></i> AWS Serverless Event-Driven Platform</span
        >
        <span class="item-meta">AWS Lambda + EventBridge + DynamoDB</span>
      </a>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label">[03] Cloud & DevOps Stack</span>
    <div class="data-stack-grid">
      <div class="stack-item" title="AWS">
        <i data-lucide="cloud"></i><span>AWS</span>
      </div>
      <div class="stack-item" title="Docker">
        <i data-lucide="container"></i><span>Docker</span>
      </div>
      <div class="stack-item" title="Kubernetes">
        <i data-lucide="server"></i><span>Kubernetes</span>
      </div>
      <div class="stack-item" title="Terraform">
        <i data-lucide="cpu"></i><span>Terraform</span>
      </div>
      <div class="stack-item" title="Linux">
        <i data-lucide="terminal"></i><span>Linux</span>
      </div>
      <div class="stack-item" title="CI/CD">
        <i data-lucide="git-branch"></i><span>CI/CD</span>
      </div>
      <div class="stack-item" title="Python">
        <i data-lucide="code-2"></i><span>Python</span>
      </div>
      <div class="stack-item" title="Bash">
        <i data-lucide="terminal-square"></i><span>Bash</span>
      </div>
      <div class="stack-item" title="Prometheus & Grafana">
        <i data-lucide="activity"></i><span>Grafana</span>
      </div>
      <div class="stack-item" title="PostgreSQL">
        <i data-lucide="database"></i><span>PostgreSQL</span>
      </div>
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="experience_label">[04] Experience</span>
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title">Cloud & DevOps Engineer</span>
        <span class="item-meta">Corporación Favorita</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Junior Cloud & Infrastructure Engineer</span>
        <span class="item-meta">Banco Pichincha</span>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/experience"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="skills_label">[05] Skills</span>
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title">Cloud Architecture & Infrastructure</span>
        <span class="item-meta">AWS / Microsoft Azure / Cloudflare</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Containers & Orchestration</span>
        <span class="item-meta">Docker / Kubernetes / Helm / EKS</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">CI/CD & GitOps Automation</span>
        <span class="item-meta">GitHub Actions / ArgoCD / GitLab CI</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Infrastructure as Code & Observability</span>
        <span class="item-meta">Terraform / Prometheus / Grafana / Bash</span>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/skills"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="education_label">[06] Education</span>
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title">B.S. Systems Engineering</span>
        <span class="item-meta">ESPE · Ecuador</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Cloud Architecture & DevOps</span>
        <span class="item-meta">Advanced Specialization · 2024</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Distributed Systems & Networks</span>
        <span class="item-meta">Executive Education · 2023</span>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/education"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="certifications_label"
      >[07] Certifications</span
    >
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title">AWS Solutions Architect</span>
        <span class="item-meta">Amazon Web Services · 2024</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">HashiCorp Terraform Associate</span>
        <span class="item-meta">HashiCorp · 2023</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Microsoft Azure Fundamentals</span>
        <span class="item-meta">AZ-900 · 2023</span>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/certifications"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="leadership_label">[08] Leadership</span>
    <div class="items-list">
      <div class="item" style="cursor: default;">
        <span class="item-title">AWS Student Builder Group Leader</span>
        <span class="item-meta">PUCE · awspuce.com</span>
      </div>
      <div class="item" style="cursor: default;">
        <span class="item-title">Cloud & DevOps Mentor</span>
        <span class="item-meta">ADPList & Tech Communities</span>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/leadership"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="events_label">[09] Events & Staff</span>

    <!-- Subhead Stats Line -->
    <div class="events-subhead-bar">
      <div class="events-subhead-pill">
        <i data-lucide="users" style="width: 12px; height: 12px;"></i>
        <span><strong>500+</strong> Attendees</span>
      </div>
      <div class="events-subhead-pill">
        <i data-lucide="presentation" style="width: 12px; height: 12px;"></i>
        <span><strong>12+</strong> Workshops</span>
      </div>
      <div class="events-subhead-pill">
        <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
        <span><strong>4</strong> Events</span>
      </div>
    </div>

    <!-- 2x2 Minimal Grid -->
    <div class="events-minimal-grid">
      <!-- 1. AWS Community Day -->
      <a href="/portfolio/events" class="event-minimal-card nav-link">
        <div class="event-minimal-thumb">
          <img src="/assets/events/aws-workshop.jpg" alt="AWS Community Day" />
          <span class="event-minimal-badge">Organizer</span>
        </div>
        <div class="event-minimal-body">
          <div class="event-minimal-top">
            <span class="event-minimal-title">AWS Community Day & PUCE</span>
            <span class="event-minimal-year">2024</span>
          </div>
          <div class="event-minimal-stat">
            <i data-lucide="users" style="width: 10px; height: 10px;"></i>
            <span>250+ students · AWS Cloud</span>
          </div>
        </div>
      </a>

      <!-- 2. Microsoft Student Summit -->
      <a href="/portfolio/events" class="event-minimal-card nav-link">
        <div class="event-minimal-thumb">
          <img src="/assets/events/microsoft-summit.jpg" alt="Microsoft Student Summit" />
          <span class="event-minimal-badge">Staff Lead</span>
        </div>
        <div class="event-minimal-body">
          <div class="event-minimal-top">
            <span class="event-minimal-title">Microsoft AI & Cloud Summit</span>
            <span class="event-minimal-year">2024</span>
          </div>
          <div class="event-minimal-stat">
            <i data-lucide="users" style="width: 10px; height: 10px;"></i>
            <span>150+ attendees · Azure & DevOps</span>
          </div>
        </div>
      </a>

      <!-- 3. DataQuito Hackathon -->
      <a href="/portfolio/events" class="event-minimal-card nav-link">
        <div class="event-minimal-thumb">
          <img src="/assets/events/data-meetup.jpg" alt="DataQuito Meetups" />
          <span class="event-minimal-badge">Co-Organizer</span>
        </div>
        <div class="event-minimal-body">
          <div class="event-minimal-top">
            <span class="event-minimal-title">Quito Cloud & DevOps Meetups</span>
            <span class="event-minimal-year">2023</span>
          </div>
          <div class="event-minimal-stat">
            <i data-lucide="users" style="width: 10px; height: 10px;"></i>
            <span>80+ participants · Cloud & Infra</span>
          </div>
        </div>
      </a>

      <!-- 4. Data & Cloud Bootcamp -->
      <a href="/portfolio/events" class="event-minimal-card nav-link">
        <div class="event-minimal-thumb">
          <img src="/assets/events/bootcamp.jpg" alt="Data Analytics Bootcamp" />
          <span class="event-minimal-badge">Speaker</span>
        </div>
        <div class="event-minimal-body">
          <div class="event-minimal-top">
            <span class="event-minimal-title">PUCE Cloud & DevOps Bootcamp</span>
            <span class="event-minimal-year">2023</span>
          </div>
          <div class="event-minimal-stat">
            <i data-lucide="users" style="width: 10px; height: 10px;"></i>
            <span>60+ attendees · Linux, Docker & AWS</span>
          </div>
        </div>
      </a>
    </div>

    <div style="margin-top: 16px;">
      <a
        href="/portfolio/events"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="blog_label">[10] Blog</span>
    <div class="items-list">
      {
        blogPosts.map((post) => (
          <a href={`/portfolio/blog/${post.id}`} class="item nav-link">
            <span class="item-title">
              <i
                data-lucide={
                  post.data.tag === "Data" ? "bar-chart-3" : "book-text"
                }
              />
              {post.data.title}
            </span>
            <span class="item-meta">
              {new Date(post.data.date).toLocaleDateString(undefined, {
                month: "short",
                year: "numeric",
              })}
            </span>
          </a>
        ))
      }
    </div>
    <div style="margin-top: 16px;">
      <a
        href="/portfolio/blog"
        class="nav-link"
        style="color: var(--text-secondary); font-family: var(--font-mono); font-size: 11px; text-decoration: none; display: flex; align-items: center; gap: 4px;"
        data-t="see_more"
        >See More <i
          data-lucide="arrow-right"
          style="width: 10px; height: 10px;"></i></a
      >
    </div>
  </section>

  <section class="animate">
    <span class="section-label" data-t="connect_label">[11] Connect</span>
    <!-- ============================================================
         CONTACT FORM — Powered by Formspree
         HOW TO ACTIVATE:
         1. Go to https://formspree.io and create a free account
         2. Click "New Form" and name it (e.g. "Portfolio Contact")
         3. Copy your form ID (looks like: xpzgkwvb)
         4. Replace YOUR_FORM_ID below with your actual ID
         That's it — Formspree handles the email delivery for free.
         ============================================================ -->
    <form id="contact-form" class="minimal-form" data-formspree-id="mgodjnpp">
      <div class="form-group">
        <input
          type="text"
          name="name"
          id="name"
          placeholder="Name"
          data-t="name_placeholder"
          required
        />
      </div>
      <div class="form-group">
        <input
          type="email"
          name="email"
          id="email"
          placeholder="Email"
          data-t="email_placeholder"
          required
        />
      </div>
      <div class="form-group">
        <textarea
          name="message"
          id="message"
          placeholder="Message..."
          data-t="message_placeholder"
          rows="3"
          required></textarea>
      </div>
      <button type="submit" class="submit-btn">
        <span data-t="send">Send</span>
        <i data-lucide="arrow-right"></i>
      </button>
    </form>
  </section>

  <section class="animate" id="network-visualizer">
    <span class="section-label" data-t="network_label"
      >[12] Cloud Infrastructure Status</span
    >
    <div class="dashboard-grid">
      <div class="dashboard-node">
        <div class="node-icon">
          <div class="status-dot"></div>
          <svg viewBox="0 0 40 40">
            <circle
              cx="20"
              cy="20"
              r="18"
              fill="none"
              stroke="currentColor"
              stroke-dasharray="4 4"
              class="radar-spin"></circle>
          </svg>
        </div>
        <div class="node-info">
          <div class="node-status" data-t="secure_node">
            KUBERNETES CLUSTER ONLINE
          </div>
          <div class="node-metrics" id="live-metrics">INITIALIZING...</div>
        </div>
      </div>
      <div class="system-logs" id="system-logs">
        <!-- Logs will be injected here -->
      </div>
    </div>
  </section>
</BaseLayout>
