---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copy from '../../components/Copy.astro';
import { copy } from '../../data/profile';
const focus = [
  { title: copy('Building repeatable cloud foundations', 'Diseñar bases cloud reproducibles'), body: copy('Exploring Terraform modules, scoped AWS identity and environment isolation through design studies.', 'Explorando módulos Terraform, identidad acotada en AWS y aislamiento de entornos mediante casos de diseño.') },
  { title: copy('Making delivery easier to reason about', 'Hacer comprensible la entrega de software'), body: copy('Connecting containers, GitOps and observability in a consistent Cloud & DevOps learning path.', 'Conectando contenedores, GitOps y observabilidad en una ruta de aprendizaje Cloud & DevOps coherente.') },
  { title: copy('Studying software and marketing', 'Estudiar software y marketing'), body: copy('Software Development at PUCE and Marketing at ISMAC: combining technical foundations with product communication.', 'Desarrollo de Software en la PUCE y Marketing en ISMAC: combinando fundamentos técnicos con comunicación de producto.') },
];
---
<BaseLayout title="Now | Jeyson Andrés Mueses" description="Current focus: Cloud & DevOps labs, software development studies and developer communities.">
  <section class="animate"><span class="section-label">[/now] Now</span><Copy as="h1" class="page-title" text={copy('What I’m focused on.', 'En qué estoy enfocado.')} /><p class="eyebrow"><Copy text={copy('Updated November 11, 2026', 'Actualizado el 11 de noviembre de 2026')} /></p><div class="profile-entries">{focus.map(item => <div class="profile-entry"><Copy as="h3" text={item.title} /><Copy as="p" class="muted" text={item.body} /></div>)}</div></section>
  <a href="/portfolio" class="text-link" data-t="back_home">Back to home</a>
</BaseLayout>
