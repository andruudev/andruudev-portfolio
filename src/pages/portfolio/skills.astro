---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Copy from "../../components/Copy.astro";
import { stack } from "../../data/profile";
---
<BaseLayout title="Cloud & DevOps Stack | Jeyson Andrés Mueses">
  <section class="animate">
    <span class="section-label" data-t="skills_label">[05] Skills</span>
    <Copy as="h1" class="page-title" text={{ en: 'From commit to reliable systems.', es: 'Del commit a sistemas confiables.' }} />
    <Copy as="p" class="section-intro" text={{ en: 'The stack explored across my cloud and DevOps labs: provision, deploy, observe and improve.', es: 'El stack que exploro en mis laboratorios cloud y DevOps: aprovisionar, desplegar, observar y mejorar.' }} />
    <div class="capability-grid">{stack.map(group => <div class="capability-card"><i data-lucide={group.icon}></i><Copy as="h3" text={group.title} /><ul>{group.tools.map(tool => <li>{tool}</li>)}</ul></div>)}</div>
  </section>
  <a href="/portfolio" class="text-link" data-t="back_home"><i data-lucide="arrow-left"></i> Back to Home</a>
</BaseLayout>
